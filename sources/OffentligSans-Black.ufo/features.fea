feature liga {
# automatic
lookupflag IgnoreMarks;
sub f i by fi;
sub f l by fl;

} liga;

feature salt {
# automatic
sub g by g.ss01;
sub l by l.ss02;
sub fl by fl.ss02;
sub ldot by ldot.ss02;

} salt;

feature ss01 {
# automatic
sub g by g.ss01;
featureNames {
    name "Alternate g";
};

} ss01;

feature ss02 {
# automatic
sub l by l.ss02;
sub fl by fl.ss02;
sub ldot by ldot.ss02;
