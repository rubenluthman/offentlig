    name "Alternate l";
};

} ss02;

feature cv01 {
# automatic
sub J by J.cv01;
sub Jcircumflex by Jcircumflex.cv01;
sub IJ by IJ.cv01;
sub IJ.cv05 by IJ.cv01.cv05;
cvParameters {
    FeatUILabelNameID {
        name "Wider J";
    };
    FeatUITooltipTextNameID {
        name "A J with a longer hook and a wider bowl, so it is harder to mistake for I or U";
    };
    SampleTextNameID {
        name "Jag gjorde jobbet";
    };
};

} cv01;

feature cv03 {
# automatic
sub G by G.cv03;
sub Gacute by Gacute.cv03;
sub Gbreve by Gbreve.cv03;
