# Prefix: Languagesystems
# automatic
languagesystem DFLT dflt;

languagesystem latn dflt;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn KAZ;
languagesystem latn TAT;
languagesystem latn TRK;
languagesystem latn ROM;
languagesystem latn MOL;
languagesystem latn CAT;


feature aalt {
# automatic
feature locl;
feature subs;
feature sinf;
feature sups;
feature numr;
feature dnom;
feature frac;
feature ordn;
feature lnum;
feature pnum;
feature tnum;
feature onum;
feature salt;
feature ss01;
feature ss02;
feature ss03;
feature cv01;
feature cv03;
feature cv04;
feature cv05;
feature cv06;
feature zero;
feature case;

} aalt;

feature ccmp {
# automatic
lookup ccmp_Other_0 {
	sub idotbelow acutecomb by idotbelow_acutecomb;
	sub istroke acutecomb by istroke_acutecomb;
	sub idotbelow gravecomb by idotbelow_gravecomb;
	sub istroke gravecomb by istroke_gravecomb;
	sub idotbelow macroncomb by idotbelow_macroncomb;
	sub istroke macroncomb by istroke_macroncomb;
	sub idotbelow tildecomb by idotbelow_tildecomb;
	sub istroke tildecomb by istroke_tildecomb;
	sub idotbelow circumflexcomb by idotbelow_circumflexcomb;
	sub istroke circumflexcomb by istroke_circumflexcomb;
	sub idotbelow brevecomb by idotbelow_brevecomb;
	sub istroke brevecomb by istroke_brevecomb;
	sub idotbelow dieresiscomb by idotbelow_dieresiscomb;
	sub istroke dieresiscomb by istroke_dieresiscomb;
	sub idotbelow caroncomb by idotbelow_caroncomb;
	sub istroke caroncomb by istroke_caroncomb;
} ccmp_Other_0;

lookup ccmp_Other_1 {
	@CombiningTopAccents = [acutecomb brevecomb breveinvertedcomb candrabinducomb caroncomb circumflexcomb commaaboverightcomb commaturnedabovecomb dblgravecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb verticallineabovecomb];
	@CombiningNonTopAccents = [brevebelowcomb cedillacomb dblmacronbelowcomb dotbelowcomb macronbelowcomb ogonekcomb ringbelowcomb horncomb];
	sub [i j iogonek]' @CombiningTopAccents by [idotless jdotless iogonek.dotless];
	sub [i j iogonek]' @CombiningNonTopAccents @CombiningTopAccents by [idotless jdotless iogonek.dotless];
	sub [idotbelow istroke]' @CombiningTopAccents by [idotbelow.dotless istroke.dotless];
	sub [idotbelow istroke]' @CombiningNonTopAccents @CombiningTopAccents by [idotbelow.dotless istroke.dotless];
} ccmp_Other_1;

lookup ccmp_Other_2 {
	# The double grave is as wide as two letters over `ı` and `r`: the narrow mark sits on them, as on ȉ and ȑ, also
	# when the base has a mark below (`ị į ɨ ṛ ṟ ŗ`; `i` has become `ı` or one of these bases by now).
	sub [idotless r idotbelow.dotless istroke.dotless iogonek.dotless rdotbelow rlinebelow rcommaaccent] dblgravecomb' by dblgravecomb.narrow;
	sub [idotless r] @CombiningNonTopAccents dblgravecomb' by dblgravecomb.narrow;
} ccmp_Other_2;

lookup ccmp_latn_1 {
	lookupflag 0;
	sub brevecomb acutecomb by brevecomb_acutecomb;
	sub brevecomb gravecomb by brevecomb_gravecomb;
	sub brevecomb hookabovecomb by brevecomb_hookabovecomb;
	sub brevecomb tildecomb by brevecomb_tildecomb;
	sub circumflexcomb acutecomb by circumflexcomb_acutecomb;
	sub circumflexcomb gravecomb by circumflexcomb_gravecomb;
	sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb;
	sub circumflexcomb tildecomb by circumflexcomb_tildecomb;
} ccmp_latn_1;

script latn;
lookup ccmp_latn_1;

} ccmp;

lookup locl_tr {
	sub i by idotaccent;
} locl_tr;

lookup locl_ro {
	sub Scedilla by Scommaaccent;
	sub scedilla by scommaaccent;
	sub Tcedilla by Tcommaaccent;
	sub tcedilla by tcommaaccent;
} locl_ro;

lookup locl_ca {
	sub  l' periodcentered' l by ldot;
	sub  L' periodcentered' L by Ldot;
} locl_ca;

feature locl {
# Each lookup is registered under every language it serves.
script latn;
language AZE;
lookup locl_tr;
language CRT;
lookup locl_tr;
language KAZ;
lookup locl_tr;
language TAT;
lookup locl_tr;
language TRK;
lookup locl_tr;
language ROM;
lookup locl_ro;
language MOL;
lookup locl_ro;
language CAT;
lookup locl_ca;
} locl;

feature subs {
# automatic
sub zero by zero.subs;
sub one by one.subs;
sub two by two.subs;
sub three by three.subs;
sub four by four.subs;
sub five by five.subs;
sub six by six.subs;
sub seven by seven.subs;
sub eight by eight.subs;
sub nine by nine.subs;

sub plus by plus.subs;
sub minus by minus.subs;
sub equal by equal.subs;
sub parenleft by parenleft.subs;
sub parenright by parenright.subs;
} subs;

feature sinf {
# automatic
sub zero by zero.subs;
sub one by one.subs;
sub two by two.subs;
sub three by three.subs;
sub four by four.subs;
sub five by five.subs;
sub six by six.subs;
sub seven by seven.subs;
sub eight by eight.subs;
sub nine by nine.subs;

sub plus by plus.subs;
sub minus by minus.subs;
sub equal by equal.subs;
sub parenleft by parenleft.subs;
sub parenright by parenright.subs;
} sinf;

feature sups {
# automatic
lookup sups_signs {
sub zero by zerosuperior;
sub one by onesuperior;
sub two by twosuperior;
sub three by threesuperior;
sub four by foursuperior;
sub five by fivesuperior;
sub six by sixsuperior;
sub seven by sevensuperior;
sub eight by eightsuperior;
sub nine by ninesuperior;

sub plus by plussuperior;
sub minus by minussuperior;
sub equal by equalsuperior;
sub parenleft by parenleftsuperior;
sub parenright by parenrightsuperior;
} sups_signs;

# The small letters follow a superior figure, sign or parenthesis, or another small letter only,
# so 1st 2nd 3rd 4th and x(n) are set, and 1er, Ste and century are not.
@sups_before = [zerosuperior onesuperior twosuperior threesuperior foursuperior fivesuperior sixsuperior sevensuperior eightsuperior ninesuperior plussuperior minussuperior equalsuperior parenleftsuperior parenrightsuperior hmod rmod smod dmod tmod nsuperior];
lookup sups_letters {
sub @sups_before [h r s d t n]' by [hmod rmod smod dmod tmod nsuperior];
} sups_letters;
} sups;

