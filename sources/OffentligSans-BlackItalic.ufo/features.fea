# Case-sensitive punctuation (docs/design-decisions.md, F4 and F18).
# `case` raises the hyphen, dashes, brackets, braces, `@` and the colon to the capital centre. `calt` does it for the hyphen,
# dashes and colon only between capitals and figures, and for `@` before a capital, never for brackets. Both run after `ss03`, so the round-dot colon has its own raised form.

@caseCap = [A AE AEacute AEmacron Aacute Abreve Abreveacute Abrevedotbelow Abrevedotbelow.ss03 Abrevegrave Abrevehookabove Abrevetilde Acaron Acircumflex Acircumflexacute Acircumflexdotbelow Acircumflexdotbelow.ss03 Acircumflexgrave Acircumflexhookabove Acircumflextilde Adblgrave Adieresis Adieresis.ss03 Adieresismacron Adieresismacron.ss03 Adotaccent Adotaccent.ss03 Adotbelow Adotbelow.ss03 Agrave Ahookabove Ainvertedbreve Amacron Aogonek Aring Aringacute Atilde B Bdotaccent Bdotaccent.ss03 Blinebelow C Cacute Ccaron Ccedilla Ccircumflex Cdotaccent Cdotaccent.ss03 Chook D Dcaron Dcedilla Dcroat Ddotaccent Ddotaccent.ss03 Ddotbelow Ddotbelow.ss03 Dlinebelow E Eacute Ebreve Ecaron Ecedilla Ecedillabreve Ecircumflex Ecircumflexacute Ecircumflexdotbelow Ecircumflexdotbelow.ss03 Ecircumflexgrave Ecircumflexhookabove Ecircumflextilde Edblgrave Edieresis Edieresis.ss03 Edotaccent Edotaccent.ss03 Edotbelow Edotbelow.ss03 Egrave Ehookabove Einvertedbreve Emacron Emacronacute Eng Eogonek Eth Etilde Ezh Ezhcaron F Fdotaccent Fdotaccent.ss03 G G.cv03 Gacute Gacute.cv03 Gbreve Gbreve.cv03 Gcaron Gcaron.cv03 Gcircumflex Gcircumflex.cv03 Gcommaaccent Gcommaaccent.cv03 Gcommaaccent.cv03.ss03 Gcommaaccent.ss03 Gdotaccent Gdotaccent.cv03 Gdotaccent.cv03.ss03 Gdotaccent.ss03 Germandbls Gmacron Gmacron.cv03 Gstroke Gstroke.cv03 H Hbar Hbrevebelow Hcaron Hcedilla Hcircumflex Hdieresis Hdieresis.ss03 Hdotaccent Hdotaccent.ss03 Hdotbelow Hdotbelow.ss03 I I.cv05 IJ IJ.cv01 IJ.cv01.cv05 IJ.cv05 Iacute Iacute.cv05 Ibreve Ibreve.cv05 Icaron Icaron.cv05 Icircumflex Icircumflex.cv05 Idblgrave Idblgrave.cv05 Idieresis Idieresis.cv05 Idieresis.cv05.ss03 Idieresis.ss03 Idieresisacute Idieresisacute.cv05 Idieresisacute.cv05.ss03 Idieresisacute.ss03 Idotaccent Idotaccent.cv05 Idotaccent.cv05.ss03 Idotaccent.ss03 Idotbelow Idotbelow.cv05 Idotbelow.cv05.ss03 Idotbelow.ss03 Igrave Igrave.cv05 Ihookabove Ihookabove.cv05 Iinvertedbreve Iinvertedbreve.cv05 Imacron Imacron.cv05 Iogonek Iogonek.cv05 Istroke Istroke.cv05 Itilde Itilde.cv05 J J.cv01 Jcircumflex Jcircumflex.cv01 K Kacute Kcaron Kcommaaccent Kcommaaccent.ss03 Kdotbelow Kdotbelow.ss03 Klinebelow L Lacute Lcaron Lcommaaccent Lcommaaccent.ss03 Ldot Ldot.ss03 Ldotbelow Ldotbelow.ss03 Llinebelow Lslash M Macute Mdotaccent Mdotaccent.ss03 Mdotbelow Mdotbelow.ss03 N Nacute Ncaron Ncommaaccent Ncommaaccent.ss03 Ndotaccent Ndotaccent.ss03 Ndotbelow Ndotbelow.ss03 Ngrave Nlinebelow Ntilde O OE Oacute Obreve Ocaron Ocircumflex Ocircumflexacute Ocircumflexdotbelow Ocircumflexdotbelow.ss03 Ocircumflexgrave Ocircumflexhookabove Ocircumflextilde Odblgrave Odieresis Odieresis.ss03 Odieresismacron Odieresismacron.ss03 Odotaccent Odotaccent.ss03 Odotaccentmacron Odotaccentmacron.ss03 Odotbelow Odotbelow.ss03 Ograve Ohm Ohookabove Ohorn Ohornacute Ohorndotbelow Ohorndotbelow.ss03 Ohorngrave Ohornhookabove Ohorntilde Ohungarumlaut Oinvertedbreve Omacron Omacronacute Oogonek Oogonekmacron Oslash Oslashacute Otilde Otildemacron P Pacute Pdotaccent Pdotaccent.ss03 Q R Racute Rcaron Rcommaaccent Rcommaaccent.ss03 Rdblgrave Rdotaccent Rdotaccent.ss03 Rdotbelow Rdotbelow.ss03 Rinvertedbreve Rlinebelow S Sacute Scaron Scedilla Schwa Scircumflex Scommaaccent Scommaaccent.ss03 Sdotaccent Sdotaccent.ss03 Sdotbelow Sdotbelow.ss03 T Tbar Tcaron Tcedilla Tcommaaccent Tcommaaccent.ss03 Tdotaccent Tdotaccent.ss03 Tdotbelow Tdotbelow.ss03 Thorn Tlinebelow U Uacute Ubreve Ucaron Ucircumflex Udblgrave Udieresis Udieresis.ss03 Udieresisacute Udieresisacute.ss03 Udieresiscaron Udieresiscaron.ss03 Udieresisgrave Udieresisgrave.ss03 Udieresismacron Udieresismacron.ss03 Udotbelow Udotbelow.ss03 Ugrave Uhookabove Uhorn Uhornacute Uhorndotbelow Uhorndotbelow.ss03 Uhorngrave Uhornhookabove Uhorntilde Uhungarumlaut Uinvertedbreve Umacron Uogonek Uring Utilde V W Wacute Wcircumflex Wdieresis Wdieresis.ss03 Wdotaccent Wdotaccent.ss03 Wgrave X Xdieresis Xdieresis.ss03 Y Yacute Ycircumflex Ydieresis Ydieresis.ss03 Ydotaccent Ydotaccent.ss03 Ydotbelow Ydotbelow.ss03 Ygrave Yhookabove Ymacron Ytilde Z Zacute Zcaron Zcircumflex Zdotaccent Zdotaccent.ss03 Zdotbelow Zdotbelow.ss03 Zlinebelow];
@caseFig = [eight eight.tf five five.tf four four.tf nine nine.tf one one.cv06 one.tf seven seven.tf six six.tf three three.tf two two.tf zero zero.slash zero.slash.tf zero.tf];
@caseAny = [@caseCap @caseFig];
@caseBase = [hyphen endash emdash parenleft parenright bracketleft bracketright braceleft braceright at colon colon.ss03];
@caseForm = [hyphen.case endash.case emdash.case parenleft.case parenright.case bracketleft.case bracketright.case braceleft.case braceright.case at.case colon.case colon.ss03.case];
@caseDash = [hyphen endash emdash];
@caseDashForm = [hyphen.case endash.case emdash.case];

feature case {
    sub @caseBase by @caseForm;
} case;

# Brackets rise in `case` only: raised by their neighbours, one of a pair could come out high and the other low.
feature calt {
    lookupflag IgnoreMarks;
    sub @caseAny @caseDash' @caseAny by @caseDashForm;
    sub @caseAny [colon colon.ss03]' @caseAny by [colon.case colon.ss03.case];
    sub at' @caseCap by at.case;
} calt;

# Typed-accent kerning: helper capitals (docs/design-decisions.md).
# A capital followed by a lowercase base and a top mark is swapped for a copy that draws the same and has its own kerning groups.

@tkMid = [horncomb ogonekcomb ringbelowcomb];
@tkTop01 = [brevecomb caroncomb];
@tkTop02 = [gravecomb];
@tkTop03 = [macroncomb tildecomb];
@tkBase000 = [iogonek.dotless s sdotbelow sdotbelow.ss03];
@tkBase001 = [aogonek aogonek.cv04 c ccedilla edotbelow edotbelow.ss03 eogonek iogonek.dotless odotbelow odotbelow.ss03 r s sdotbelow sdotbelow.ss03 udotbelow udotbelow.ss03 uogonek];
@tkBase002 = [iogonek.dotless];
@tkBase003 = [aogonek aogonek.cv04 c ccedilla edotbelow edotbelow.ss03 eogonek iogonek.dotless k kdotbelow kdotbelow.ss03 odotbelow odotbelow.ss03 r s sdotbelow sdotbelow.ss03 udotbelow udotbelow.ss03 uogonek];
@tkBase004 = [iogonek.dotless s sdotbelow];
@tkBase005 = [aogonek aogonek.cv04 c ccedilla edotbelow eogonek iogonek.dotless odotbelow r s sdotbelow udotbelow uogonek];
@tkBase006 = [iogonek.dotless s sdotbelow.ss03];
@tkBase007 = [aogonek aogonek.cv04 c ccedilla edotbelow.ss03 eogonek iogonek.dotless odotbelow.ss03 r s sdotbelow.ss03 udotbelow.ss03 uogonek];
@tkBase008 = [aogonek aogonek.cv04 c ccedilla edotbelow edotbelow.ss03 eogonek iogonek.dotless odotbelow odotbelow.ss03 r s sdotbelow sdotbelow.ss03];
@tkBase009 = [aogonek aogonek.cv04 c ccedilla edotbelow eogonek iogonek.dotless odotbelow r s sdotbelow];
@tkBase010 = [aogonek aogonek.cv04 c ccedilla edotbelow.ss03 eogonek iogonek.dotless odotbelow.ss03 r s sdotbelow.ss03];
@tkBase011 = [aogonek aogonek.cv04 c ccedilla edotbelow edotbelow.ss03 eogonek iogonek.dotless odotbelow odotbelow.ss03 s sdotbelow sdotbelow.ss03];
@tkBase012 = [c ccedilla edotbelow edotbelow.ss03 eogonek iogonek.dotless odotbelow odotbelow.ss03];
@tkBase013 = [aogonek aogonek.cv04 c ccedilla edotbelow eogonek iogonek.dotless odotbelow s sdotbelow];
@tkBase014 = [c ccedilla edotbelow eogonek iogonek.dotless odotbelow];
@tkBase015 = [aogonek aogonek.cv04 c ccedilla edotbelow.ss03 eogonek iogonek.dotless odotbelow.ss03 s sdotbelow.ss03];
@tkBase016 = [c ccedilla edotbelow.ss03 eogonek iogonek.dotless odotbelow.ss03];

feature rclt {
    sub [Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase011 @tkTop01 by [Y.tk01 Yacute.tk01 Ycircumflex.tk01 Ygrave.tk01 Yhookabove.tk01 Ymacron.tk01 Ytilde.tk01];
    sub [Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase011 @tkMid @tkTop01 by [Y.tk01 Yacute.tk01 Ycircumflex.tk01 Ygrave.tk01 Yhookabove.tk01 Ymacron.tk01 Ytilde.tk01];
    sub [Ydieresis Ydotaccent Ydotbelow]' @tkBase013 @tkTop01 by [Ydieresis.tk01 Ydotaccent.tk01 Ydotbelow.tk01];
    sub [Ydieresis Ydotaccent Ydotbelow]' @tkBase013 @tkMid @tkTop01 by [Ydieresis.tk01 Ydotaccent.tk01 Ydotbelow.tk01];
    sub [Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase015 @tkTop01 by [Ydieresis.ss03.tk01 Ydotaccent.ss03.tk01 Ydotbelow.ss03.tk01];
    sub [Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase015 @tkMid @tkTop01 by [Ydieresis.ss03.tk01 Ydotaccent.ss03.tk01 Ydotbelow.ss03.tk01];
    sub [V W Wacute Wcircumflex Wdieresis Wdieresis.ss03 Wdotaccent Wdotaccent.ss03 Wgrave]' @tkBase002 @tkTop01 by [V.tk01 W.tk01 Wacute.tk01 Wcircumflex.tk01 Wdieresis.tk01 Wdieresis.ss03.tk01 Wdotaccent.tk01 Wdotaccent.ss03.tk01 Wgrave.tk01];
    sub [V W Wacute Wcircumflex Wdieresis Wdieresis.ss03 Wdotaccent Wdotaccent.ss03 Wgrave]' @tkBase002 @tkMid @tkTop01 by [V.tk01 W.tk01 Wacute.tk01 Wcircumflex.tk01 Wdieresis.tk01 Wdieresis.ss03.tk01 Wdotaccent.tk01 Wdotaccent.ss03.tk01 Wgrave.tk01];
    sub [Tcommaaccent Tdotaccent Tdotbelow]' @tkBase004 @tkTop01 by [Tcommaaccent.tk01 Tdotaccent.tk01 Tdotbelow.tk01];
    sub [Tcommaaccent Tdotaccent Tdotbelow]' @tkBase004 @tkMid @tkTop01 by [Tcommaaccent.tk01 Tdotaccent.tk01 Tdotbelow.tk01];
    sub [T Tbar Tcaron Tcedilla Tlinebelow]' @tkBase000 @tkTop01 by [T.tk01 Tbar.tk01 Tcaron.tk01 Tcedilla.tk01 Tlinebelow.tk01];
    sub [T Tbar Tcaron Tcedilla Tlinebelow]' @tkBase000 @tkMid @tkTop01 by [T.tk01 Tbar.tk01 Tcaron.tk01 Tcedilla.tk01 Tlinebelow.tk01];
    sub [Tcommaaccent.ss03 Tdotaccent.ss03 Tdotbelow.ss03]' @tkBase006 @tkTop01 by [Tcommaaccent.ss03.tk01 Tdotaccent.ss03.tk01 Tdotbelow.ss03.tk01];
    sub [Tcommaaccent.ss03 Tdotaccent.ss03 Tdotbelow.ss03]' @tkBase006 @tkMid @tkTop01 by [Tcommaaccent.ss03.tk01 Tdotaccent.ss03.tk01 Tdotbelow.ss03.tk01];
    sub Tcaron' @tkBase003 @tkTop02 by Tcaron.tk02;
    sub Tcaron' @tkBase003 @tkMid @tkTop02 by Tcaron.tk02;
    sub [V W Wacute Wcircumflex Wgrave]' @tkBase008 @tkTop02 by [V.tk02 W.tk02 Wacute.tk02 Wcircumflex.tk02 Wgrave.tk02];
    sub [V W Wacute Wcircumflex Wgrave]' @tkBase008 @tkMid @tkTop02 by [V.tk02 W.tk02 Wacute.tk02 Wcircumflex.tk02 Wgrave.tk02];
    sub [T Tbar Tcedilla Tlinebelow Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase001 @tkTop02 by [T.tk02 Tbar.tk02 Tcedilla.tk02 Tlinebelow.tk02 Y.tk02 Yacute.tk02 Ycircumflex.tk02 Ygrave.tk02 Yhookabove.tk02 Ymacron.tk02 Ytilde.tk02];
    sub [T Tbar Tcedilla Tlinebelow Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase001 @tkMid @tkTop02 by [T.tk02 Tbar.tk02 Tcedilla.tk02 Tlinebelow.tk02 Y.tk02 Yacute.tk02 Ycircumflex.tk02 Ygrave.tk02 Yhookabove.tk02 Ymacron.tk02 Ytilde.tk02];
    sub [Wdieresis Wdotaccent]' @tkBase009 @tkTop02 by [Wdieresis.tk02 Wdotaccent.tk02];
    sub [Wdieresis Wdotaccent]' @tkBase009 @tkMid @tkTop02 by [Wdieresis.tk02 Wdotaccent.tk02];
    sub [Tcommaaccent Tdotaccent Tdotbelow Ydieresis Ydotaccent Ydotbelow]' @tkBase005 @tkTop02 by [Tcommaaccent.tk02 Tdotaccent.tk02 Tdotbelow.tk02 Ydieresis.tk02 Ydotaccent.tk02 Ydotbelow.tk02];
    sub [Tcommaaccent Tdotaccent Tdotbelow Ydieresis Ydotaccent Ydotbelow]' @tkBase005 @tkMid @tkTop02 by [Tcommaaccent.tk02 Tdotaccent.tk02 Tdotbelow.tk02 Ydieresis.tk02 Ydotaccent.tk02 Ydotbelow.tk02];
    sub [Wdieresis.ss03 Wdotaccent.ss03]' @tkBase010 @tkTop02 by [Wdieresis.ss03.tk02 Wdotaccent.ss03.tk02];
    sub [Wdieresis.ss03 Wdotaccent.ss03]' @tkBase010 @tkMid @tkTop02 by [Wdieresis.ss03.tk02 Wdotaccent.ss03.tk02];
    sub [Tcommaaccent.ss03 Tdotaccent.ss03 Tdotbelow.ss03 Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase007 @tkTop02 by [Tcommaaccent.ss03.tk02 Tdotaccent.ss03.tk02 Tdotbelow.ss03.tk02 Ydieresis.ss03.tk02 Ydotaccent.ss03.tk02 Ydotbelow.ss03.tk02];
    sub [Tcommaaccent.ss03 Tdotaccent.ss03 Tdotbelow.ss03 Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase007 @tkMid @tkTop02 by [Tcommaaccent.ss03.tk02 Tdotaccent.ss03.tk02 Tdotbelow.ss03.tk02 Ydieresis.ss03.tk02 Ydotaccent.ss03.tk02 Ydotbelow.ss03.tk02];
    sub [Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase012 @tkTop03 by [Y.tk03 Yacute.tk03 Ycircumflex.tk03 Ygrave.tk03 Yhookabove.tk03 Ymacron.tk03 Ytilde.tk03];
    sub [Y Yacute Ycircumflex Ygrave Yhookabove Ymacron Ytilde]' @tkBase012 @tkMid @tkTop03 by [Y.tk03 Yacute.tk03 Ycircumflex.tk03 Ygrave.tk03 Yhookabove.tk03 Ymacron.tk03 Ytilde.tk03];
    sub [Ydieresis Ydotaccent Ydotbelow]' @tkBase014 @tkTop03 by [Ydieresis.tk03 Ydotaccent.tk03 Ydotbelow.tk03];
    sub [Ydieresis Ydotaccent Ydotbelow]' @tkBase014 @tkMid @tkTop03 by [Ydieresis.tk03 Ydotaccent.tk03 Ydotbelow.tk03];
    sub [Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase016 @tkTop03 by [Ydieresis.ss03.tk03 Ydotaccent.ss03.tk03 Ydotbelow.ss03.tk03];
    sub [Ydieresis.ss03 Ydotaccent.ss03 Ydotbelow.ss03]' @tkBase016 @tkMid @tkTop03 by [Ydieresis.ss03.tk03 Ydotaccent.ss03.tk03 Ydotbelow.ss03.tk03];
    sub [T Tbar Tcaron Tcedilla Tcommaaccent Tcommaaccent.ss03 Tdotaccent Tdotaccent.ss03 Tdotbelow Tdotbelow.ss03 Tlinebelow V W Wacute Wcircumflex Wdieresis Wdieresis.ss03 Wdotaccent Wdotaccent.ss03 Wgrave]' @tkBase002 @tkTop03 by [T.tk03 Tbar.tk03 Tcaron.tk03 Tcedilla.tk03 Tcommaaccent.tk03 Tcommaaccent.ss03.tk03 Tdotaccent.tk03 Tdotaccent.ss03.tk03 Tdotbelow.tk03 Tdotbelow.ss03.tk03 Tlinebelow.tk03 V.tk03 W.tk03 Wacute.tk03 Wcircumflex.tk03 Wdieresis.tk03 Wdieresis.ss03.tk03 Wdotaccent.tk03 Wdotaccent.ss03.tk03 Wgrave.tk03];
    sub [T Tbar Tcaron Tcedilla Tcommaaccent Tcommaaccent.ss03 Tdotaccent Tdotaccent.ss03 Tdotbelow Tdotbelow.ss03 Tlinebelow V W Wacute Wcircumflex Wdieresis Wdieresis.ss03 Wdotaccent Wdotaccent.ss03 Wgrave]' @tkBase002 @tkMid @tkTop03 by [T.tk03 Tbar.tk03 Tcaron.tk03 Tcedilla.tk03 Tcommaaccent.tk03 Tcommaaccent.ss03.tk03 Tdotaccent.tk03 Tdotaccent.ss03.tk03 Tdotbelow.tk03 Tdotbelow.ss03.tk03 Tlinebelow.tk03 V.tk03 W.tk03 Wacute.tk03 Wcircumflex.tk03 Wdieresis.tk03 Wdieresis.ss03.tk03 Wdotaccent.tk03 Wdotaccent.ss03.tk03 Wgrave.tk03];
} rclt;

# The shorter-arm capitals T.arm and Y.arm sit in front of a letter with a tall mark, so the capital can be kerned like the plain pair.
feature calt {
    sub [T Tbar Tcaron Tcedilla Tcommaaccent Tcommaaccent.ss03 Tdotaccent Tdotaccent.ss03 Tdotbelow Tdotbelow.ss03 Tlinebelow]' [edieresis edieresis.ss03 odieresis odieresis.ss03 odieresismacron odieresismacron.ss03 scaron scircumflex ydieresis ydieresis.ss03] by [T.arm Tbar.arm Tcaron.arm Tcedilla.arm Tcommaaccent.arm Tcommaaccent.ss03.arm Tdotaccent.arm Tdotaccent.ss03.arm Tdotbelow.arm Tdotbelow.ss03.arm Tlinebelow.arm];
    sub [Y Yacute Ycircumflex Ydieresis Ydieresis.ss03 Ydotaccent Ydotaccent.ss03 Ydotbelow Ydotbelow.ss03 Ygrave Yhookabove Ymacron Ytilde]' [acaron acaron.cv04 adieresis adieresis.cv04 adieresis.cv04.ss03 adieresis.ss03 adieresismacron adieresismacron.cv04 adieresismacron.cv04.ss03 adieresismacron.ss03 agrave agrave.cv04 ccaron ebreve ecaron ecedillabreve edieresis edieresis.ss03 emacron emacronacute gbreve gbreve.ss01 gcaron gcaron.ss01 obreve ocaron odieresis odieresis.ss03 odieresismacron odieresismacron.ss03 ohorntilde omacron omacronacute oogonekmacron scaron udieresis udieresis.ss03 udieresisacute udieresisacute.ss03 udieresiscaron udieresiscaron.ss03 udieresisgrave udieresisgrave.ss03 udieresismacron udieresismacron.ss03 ugrave uhorngrave ydieresis ydieresis.ss03 ygrave zcaron] by [Y.arm Yacute.arm Ycircumflex.arm Ydieresis.arm Ydieresis.ss03.arm Ydotaccent.arm Ydotaccent.ss03.arm Ydotbelow.arm Ydotbelow.ss03.arm Ygrave.arm Yhookabove.arm Ymacron.arm Ytilde.arm];
} calt;
