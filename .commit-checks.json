{
  "version": "v0.7.4",
  "commit": "67d798685b9f2ab55b72a971352ad98540af20cb",
  "source": "https://github.com/rubenluthman/commit-checks.git",
  "visibility": "public",
  "docs_only": {
    "paths": ["*.md"],
    "except": ["ARCHITECTURE.md", "CHANGELOG.md"]
  },
  "vale": {
    "globs": ["*.md", "*.txt"],
    "exclude": ["LICENSE", "AUTHORS.txt", "CONTRIBUTORS.txt"]
  },
  "allow": [
    {
      "rule": "emails",
      "path": "AUTHORS.txt",
      "reason": "upstream font authors' addresses, credited in the open-source project files they came with"
    },
    {
      "rule": "emails",
      "path": "CONTRIBUTORS.txt",
      "reason": "upstream contributors' addresses, credited in the open-source project files they came with"
    },
    {
      "rule": "generic-api-key",
      "path": "sources/*.ufo/kerning.plist",
      "reason": "long glyph names in kerning pairs look like random keys; the files hold no secrets"
    }
  ]
}
